<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Plata Bank</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-university"></i>
                    Mi Plata Bank
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="fas fa-home me-1"></i>Inicio
                            </a>
                        </li>
                        @if (Context.Session.GetString("NumeroCuenta") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Transacciones">
                                    <i class="fas fa-exchange-alt me-1"></i>Transacciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Perfil">
                                    <i class="fas fa-user-cog me-1"></i>Perfil
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetString("NumeroCuenta") != null)
                        {
                            var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Usuario";
                            var iniciales = ObtenerIniciales(nombreUsuario);
                            var colorAvatar = ObtenerColorAvatar(nombreUsuario);

                            <li class="nav-item d-flex align-items-center me-3">
                                <div class="avatar-circle avatar-color-@colorAvatar me-2">
                                    @iniciales
                                </div>
                                <span class="text-white fw-semibold d-none d-md-inline">
                                    @nombreUsuario
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Logout">
                                    <i class="fas fa-sign-out-alt me-1"></i>Salir
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Register">
                                    <i class="fas fa-user-plus me-1"></i>Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted bg-light mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-gradient">
                        <i class="fas fa-university"></i> Mi Plata Bank
                    </h5>
                    <p class="text-muted small">Tu banco digital de confianza en Colombia 🇨🇴</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold" style="color: var(--color-primary);">Contacto</h6>
                    <p class="mb-1 small">
                        <i class="fas fa-phone text-muted me-2"></i>
                        <a href="tel:6041234567">(604) 123-4567</a>
                    </p>
                    <p class="mb-1 small">
                        <i class="fas fa-envelope text-muted me-2"></i>
                        <a href="mailto:info@miplata.com.co">info@miplata.com.co</a>
                    </p>
                    <p class="mb-1 small">
                        <i class="fas fa-map-marker-alt text-muted me-2"></i>
                        Medellín, Antioquia
                    </p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold" style="color: var(--color-primary);">Síguenos</h6>
                    <div class="d-flex gap-3">
                        <a href="#" class="icon-box primary">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="icon-box warning">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="icon-box info">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="icon-box success">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr style="border-color: var(--color-primary); opacity: 0.2;" />
            <div class="text-center">
                <small class="text-muted">
                    &copy; 2024 Mi Plata Bank - Todos los derechos reservados |
                    <span class="text-gradient">Made with ❤️ in Medellín</span>
                </small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // Función para obtener las iniciales del nombre
    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "US";

        var palabras = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (palabras.Length == 1)
        {
            // Si es una sola palabra, tomar las primeras 2 letras
            return palabras[0].Length >= 2
                ? palabras[0].Substring(0, 2).ToUpper()
                : palabras[0].ToUpper();
        }
        else
        {
            // Si son dos o más palabras, tomar la primera letra de las primeras dos
            return (palabras[0][0].ToString() + palabras[1][0].ToString()).ToUpper();
        }
    }

    // Función para obtener un color aleatorio pero consistente basado en el nombre
    private int ObtenerColorAvatar(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return 1;

        // Generar un número entre 1 y 5 basado en el hash del nombre
        int hash = 0;
        foreach (char c in nombre)
        {
            hash += (int)c;
        }

        return (hash % 5) + 1;
    }
}